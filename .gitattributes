# Normalize text line endings across machines
* text=auto

# ---- Git LFS tracked media types ----
# Design / layout
*.psd  filter=lfs diff=lfs merge=lfs -text
*.ai   filter=lfs diff=lfs merge=lfs -text
*.indd filter=lfs diff=lfs merge=lfs -text

# Video / audio
*.mov  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mxf  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text

# High-res images
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text

# Camera raw
*.cr2  filter=lfs diff=lfs merge=lfs -text
*.cr3  filter=lfs diff=lfs merge=lfs -text
*.nef  filter=lfs diff=lfs merge=lfs -text
*.arw  filter=lfs diff=lfs merge=lfs -text
*.dng  filter=lfs diff=lfs merge=lfs -text

# Archives / delivery packages
*.zip  filter=lfs diff=lfs merge=lfs -text
*.7z   filter=lfs diff=lfs merge=lfs -text
